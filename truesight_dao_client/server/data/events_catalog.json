    "MEDIA RETRACTION EVENT": {
      "category": "Other",
      "description": "Invalidate/retract one or more boundary media submissions (soft-delete: keeps the row, adds invalidated_at/by/reason/source, drops the item out of polygon computation). Triggers a recalculation of the plot polygon (re-run convex hull on remaining GPS points) and regeneration of plots/index.geojson. Three-tier retraction model: submitting farmer/farm lead (own submissions), governor (anything by default), or Sentinel (automated, on satellite-contradiction evidence). See plans/SUNMINT_MEDIA_INVALIDATION_DESIGN.md.",
      "canonical_labels": [
        "Plot ID",
        "Media URLs",
        "Reason",
        "Retractor Email",
        "Retraction Source"
      ],
      "required_fields": [
        "Plot ID",
        "Media URLs",
        "Reason",
